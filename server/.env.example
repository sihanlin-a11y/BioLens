# BioLens AI relay — environment variables
# ==========================================
# 1. Copy this file to ".env"  (cp .env.example .env)
# 2. Paste your free Gemini key below (get one at https://aistudio.google.com/app/apikey)
# 3. NEVER commit the real .env file to git.

GEMINI_API_KEY=paste-your-key-here

# Optional: change the model. gemini-2.0-flash is fast and free-tier friendly.
GEMINI_MODEL=gemini-2.0-flash
